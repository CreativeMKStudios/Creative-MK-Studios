---
import { site } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="stack">
      <p class="footer-brand">{site.name}</p>
      <p class="fine">
        Web design for small businesses in Milton Keynes and Bedfordshire.
        {site.founder} trades as {site.shortName}.
      </p>
      <a class="text-link" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    <nav class="footer-links" aria-label="Footer">
      <a href="/web-design-milton-keynes">Milton Keynes</a>
      <a href="/web-design-bedfordshire">Bedfordshire</a>
      <a href="/pricing">Pricing</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
      <a href="/privacy">Privacy</a>
    </nav>
    <p class="fine">© {year} {site.name}</p>
  </div>
</footer>

---
import Base from "../layouts/Base.astro";
import PageIntro from "../components/PageIntro.astro";

const title = "Page not found | Creative MK Studios";
const description = "That page is not on the Creative MK Studios site.";
---

<Base title={title} description={description} path="/404" noindex={true}>
  <PageIntro
    title="That page is missing."
    lede="The link may be old, or the address may be typed wrong."
    crumbs={[
      { href: "/", label: "Home" },
      { label: "Missing page" },
    ]}
  />
  <div class="page-body">
    <div class="wrap">
      <a class="text-link" href="/">Back to the home page</a>
    </div>
  </div>
</Base>
